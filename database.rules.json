          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!root.child('rooms').child($code).child('game/status').exists() || root.child('rooms').child($code).child('game/status').val() === 'lobby')",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'token', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "token": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "answers": {
          ".read": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('game/status').val() === 'playing'",
            ".validate": "!newData.exists() || (newData.hasChildren(['qid', 'choice']) && newData.child('qid').isString() && newData.child('choice').isNumber())"
          }
        },
        "kart": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          "input": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('game/status').val() === 'playing'",
              ".validate": "newData.hasChildren(['s']) && newData.child('s').isNumber() && newData.child('s').val() >= -1 && newData.child('s').val() <= 1 && (!newData.child('use').exists() || newData.child('use').isNumber())"
            }
          }
        },
        "clash": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          "pick": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (!root.child('rooms').child($code).child('game/status').exists() || root.child('rooms').child($code).child('game/status').val() === 'lobby')",
              ".validate": "!newData.exists() || (newData.hasChildren(['side', 'c']) && (newData.child('side').val() === 'red' || newData.child('side').val() === 'blue'))",
              "side": {
                ".validate": "newData.isString()"
              },
              "c": {
